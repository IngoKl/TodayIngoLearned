<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>


<main class="flex-shrink-0">
    <div class="container">

        <h2>Study Mode</h2>
        <p><a href="/study/stats" class="btn btn-outline-secondary btn-sm">Study Stats</a></p><br/>

        <p>
            This is <strong>repetition no. <%=til.repetitions %></strong>. You last looked at this in study mode on <em><%=til.last_repetition.toLocaleString('de-DE') %></em>.
        </p>

        <hr>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <% ['easy', 'ok', 'hard', 'mute'].forEach(function(result) { %>
                <form method="POST" action="/study/<%= til.til_id %>/<%= result %>" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn <%= result === 'easy' ? 'btn-success' : result === 'ok' ? 'btn-warning' : result === 'hard' ? 'btn-danger' : 'btn-secondary' %>">
                        <%= result === 'ok' ? 'OK' : result.charAt(0).toUpperCase() + result.slice(1) %>
                    </button>
                </form>
            <% }); %>
        </div>
        <hr>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><%= til.title %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= til.date.toLocaleDateString('de-DE') %></h6>
                <% for (let tag in til.tags) { %>
                    <a href="/tag/<%=til.tags[tag].substring(1) %>"><span class="badge bg-secondary"><%=til.tags[tag] %></span></a>
                <% } %>

                <hr>
                <p class="card-text md description" data-til-id="<%= til.til_id %>"><%=til.description %></p>
                <hr>

                <a href="/comment/add/<%= til.til_id %>" class="btn btn-secondary">Add Comment</a>
                <a href="/til/edit/<%= til.til_id %>" class="btn btn-primary">Edit</a>
            </div>
        </div><br>

        
        <% for (var i = 0; i < comments.length; i++) { %>
            <div class="card">
                <div class="card-body">
                    <p class="md description"><%=comments[i].comment %></p>
                    <hr>
                    <a href="/comment/edit/<%= comments[i].id %>"><button class="btn btn-secondary">Edit</button></a>
                </div>
            </div>
            <br>
        <% } %>

    </div>
</main>

<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>
