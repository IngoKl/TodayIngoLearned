<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title>TodayIngoLearned</title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">
        <form method="POST" target="">
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea id="comment" name="comment" rows="5" class="form-control"><%= comment.comment %></textarea>
            </div>
            <div class="mb-3">
              <button name="submit" type="submit" class="btn btn-primary">Save</button>
            </div>
          </form>       
          <hr>
          <a href="/comment/edit/<%= comment.id %>/delete"><button class="btn btn-danger">Delete</button></a>   
    </div>
</main>


<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>