<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">
        <form method="POST" target="">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea id="comment" name="comment" rows="5" class="form-control"><%= comment.comment %></textarea>
            </div>
            <div class="mb-3">
              <button name="submit" type="submit" class="btn btn-primary">Save</button>
            </div>
          </form>
          <hr>
          <form method="POST" action="/comment/delete/<%= comment.id %>" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this comment?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger">Delete</button>
          </form>
    </div>
</main>


<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>