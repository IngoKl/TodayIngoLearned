<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">
        <h2>Add New TIL</h2>
        <br>


        <form id="edittil" method="POST" target="">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <% if(title){ %>
              <input id="title" name="title" placeholder="TIL" type="text" required="required" class="form-control" value="<%= title %>">
            <% } else{ %>
              <input id="title" name="title" placeholder="TIL" type="text" required="required" class="form-control">
            <% } %>
          </div>
          <div class="mb-3">
            <label for="date" class="form-label">Day</label>
            <input id="date" name="date" type="date" class="form-control" value="<%=today %>">
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>

            <div class="md-toolbar mb-2">
              <button id="md-bold" type="button" class="btn btn-secondary btn-sm"><strong>bold</strong></button>
              <button id="md-italics" type="button" class="btn btn-secondary btn-sm"><em>italics</em></button>
              <button id="md-link" type="button" class="btn btn-secondary btn-sm">link (e)</button>
              <button id="md-ilink" type="button" class="btn btn-secondary btn-sm">link (i)</button>
              <button id="md-tag" type="button" class="btn btn-secondary btn-sm">#tag</button>
            </div>

            <textarea id="description" name="description" rows="10" aria-describedby="descriptionHelpBlock" class="form-control"></textarea>
            <span id="descriptionHelpBlock" class="form-text text-muted">You can simply use hashtags in here that will then be converted to "Tags".</span>
          </div>
          <div class="mb-3">
            <button name="submit" type="submit" class="btn btn-primary">Add</button>
          </div>
        </form>  

    </div>
</main>


<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>