<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation') %>

<%
    const currentSearchType = typeof searchtype !== 'undefined' ? searchtype : 'title';
    const currentSearch = typeof search !== 'undefined' ? search : '';
%>

<main class="flex-shrink-0">
    <div class="container">
        <div class="home-primary-actions home-primary-actions-top">
            <a href="/til/add" class="btn btn-primary home-primary-action">New TIL</a>
        </div>

        <section class="home-search-panel">
            <div class="home-search-header">
                <div>
                    <p class="home-search-kicker">Browse</p>
                    <h2 class="home-search-title">Find a TIL</h2>
                </div>
            </div>

            <form method="POST" action="/" class="home-search-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="home-search-fields">
                    <div class="home-search-field home-search-field-type">
                        <label class="form-label" for="searchtype">Search by</label>
                        <select class="form-select" id="searchtype" name="searchtype">
                            <option value="title" <%= currentSearchType === 'title' ? 'selected' : '' %>>Title</option>
                            <option value="text" <%= currentSearchType === 'text' ? 'selected' : '' %>>Text</option>
                            <option value="tag" <%= currentSearchType === 'tag' ? 'selected' : '' %>>Tag</option>
                            <option value="date" <%= currentSearchType === 'date' ? 'selected' : '' %>>Date</option>
                        </select>
                    </div>
                    <div class="home-search-field home-search-field-query">
                        <label class="form-label" for="search">Query</label>
                        <input type="<%= currentSearchType === 'date' ? 'date' : 'text' %>" class="form-control" id="search" name="search" placeholder="Search your TILs" value="<%= currentSearch %>">
                    </div>
                </div>
                <div class="home-search-actions">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>
        </section>

        <hr class="home-section-divider">

        <p style="font-size: 1.5em;">Hey <strong><%= user.username %></strong>, here are your TILs:</p>

        <% if (currentSearch) { %>
            <div class="search-results">
                <p>Searching for <%= currentSearchType %>: <strong><%= currentSearch %></strong>. <%= typeof totalResults !== 'undefined' ? totalResults : tils_keys.length %> results found.</p>
            </div>
        <% } %>

        <% if (tils_keys.length > 0) { %>
            <% for (let i in tils_keys) { %>
            <% let til = tils_objects[tils_keys[i]]; %>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><%= til.title %></h5>
                    <h6 class="card-subtitle mb-2 text-muted"><%= til.date.toLocaleDateString('de-DE') %></h6>
                    <% for (let tag in til.tags) { %>
                        <a href="/tag/<%=til.tags[tag].substring(1) %>"><span class="badge bg-secondary"><%=til.tags[tag] %></span></a>
                    <% } %>
                    <% if (til.public) { %>
                        <span class="badge bg-success">Public</span>
                    <% } %>
                    <hr>
                    <% if (til.snippet) { %>
                        <p class="card-text search-snippet"><%- til.snippet %></p>
                    <% } %>
                    <p class="card-text md description" data-til-id="<%= til.til_id %>"><%=til.description %></p>
                    <hr>
                    <a href="/til/view/<%= til.til_id %>" class="btn btn-secondary">View</a>
                    <a href="/comment/add/<%= til.til_id %>" class="btn btn-primary">Add Comment</a>
                    <a href="/til/edit/<%= til.til_id %>" class="btn btn-primary">Edit</a>
                </div>
            </div><br>
            <% } %>
        <% } %>

        <% if (tils_keys.length == 0) { %>
            Unfortunately, <em>no TILs</em> have been found.
        <% } %>

        <%- include ('partials/pagination') %>
    </div>
</main>

<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>

</body>

</html>
