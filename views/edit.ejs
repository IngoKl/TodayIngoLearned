<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">   
      <h2>Edit <em><%= til.title %></em></h2>
      <br>
      <form id="edittil" method="POST" target="">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input id="title" name="title" placeholder="TIL" type="text" required="required" class="form-control" value="<%= til.title %>">
          </div>
          <div class="mb-3">
            <label for="date" class="form-label">Day</label>
            <input id="date" name="date" type="date" class="form-control" value="<%= date %>">
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>

            <div class="md-toolbar mb-2">
              <button id="md-bold" type="button" class="btn btn-secondary btn-sm"><strong>bold</strong></button>
              <button id="md-italics" type="button" class="btn btn-secondary btn-sm"><em>italics</em></button>
              <button id="md-link" type="button" class="btn btn-secondary btn-sm">link (e)</button>
              <button id="md-ilink" type="button" class="btn btn-secondary btn-sm">link (i)</button>
              <button id="md-tag" type="button" class="btn btn-secondary btn-sm">#tag</button>
              <button id="md-image" type="button" class="btn btn-secondary btn-sm">image</button>
              <button id="md-draw" type="button" class="btn btn-secondary btn-sm">draw</button>
              <input type="file" id="image-upload" accept="image/*" style="display:none">
            </div>

            <textarea id="description" name="description" rows="10" aria-describedby="descriptionHelpBlock" class="form-control"><%= til.description %></textarea>
            <span id="descriptionHelpBlock" class="form-text text-muted">You can simply use hashtags in here that will then be converted to "Tags".</span>
            <div id="image-gallery" class="mt-2 d-flex flex-wrap gap-2" data-til-id="<%= til.id %>"></div>
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="public" name="public" value="1" <%= til.public ? 'checked' : '' %>>
            <label class="form-check-label" for="public">Public</label>
            <span class="form-text text-muted d-block">Makes this TIL accessible via a public link without login.</span>
          </div>
          <div class="mb-3">
            <button name="submit" type="submit" class="btn btn-primary">Save</button>
          </div>
        </form>
        <hr>
        <a href="/til/edit/<%= til.id %>/delete"><button class="btn btn-danger">Delete</button></a>  
    </div>
</main>


<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>