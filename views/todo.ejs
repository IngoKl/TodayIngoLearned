<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %> - To-Do</title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">

    <h2>To-Do</h2>

    <h4>#todo Tagged</h4>
    <hr>

    <% if (todo_keys.length === 0) { %>
        <p class="text-muted">No TILs tagged with #todo.</p>
    <% } %>

    <% for (let i in todo_keys) { %>
        <% let til = todo_objects[todo_keys[i]]; %>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><%= til.title %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= til.date.toLocaleDateString('de-DE') %></h6>
                <% for (let tag in til.tags) { %>
                    <a href="/tag/<%=til.tags[tag].substring(1) %>"><span class="badge bg-secondary"><%=til.tags[tag] %></span></a>
                <% } %>
                <% if (til.public) { %>
                    <span class="badge bg-success">Public</span>
                <% } %>
                <hr>
                <p class="card-text md description" data-til-id="<%= til.til_id %>"><%=til.description %></p>
                <hr>
                <a href="/til/view/<%= til.til_id %>" class="btn btn-secondary">View</a>
                <a href="/til/edit/<%= til.til_id %>" class="btn btn-primary">Edit</a>
            </div>
        </div><br>
    <% } %>

    <h4>Empty TILs</h4>
    <hr>

    <% if (empty_keys.length === 0) { %>
        <p class="text-muted">No empty TILs.</p>
    <% } %>

    <% for (let i in empty_keys) { %>
        <% let til = empty_objects[empty_keys[i]]; %>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><%= til.title %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= til.date.toLocaleDateString('de-DE') %></h6>
                <% for (let tag in til.tags) { %>
                    <a href="/tag/<%=til.tags[tag].substring(1) %>"><span class="badge bg-secondary"><%=til.tags[tag] %></span></a>
                <% } %>
                <% if (til.public) { %>
                    <span class="badge bg-success">Public</span>
                <% } %>
                <hr>
                <a href="/til/view/<%= til.til_id %>" class="btn btn-secondary">View</a>
                <a href="/til/edit/<%= til.til_id %>" class="btn btn-primary">Edit</a>
            </div>
        </div><br>
    <% } %>

    </div>
</main>

<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>