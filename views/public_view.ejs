<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="author" content="<%= author %>">

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= til.title %>">
    <meta property="og:description" content="<%= til.description.replace(/[#*_\[\]`>]/g, '').substring(0, 200) %>">
    <meta property="og:site_name" content="<%= appName %>">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= til.title %>">
    <meta name="twitter:description" content="<%= til.description.replace(/[#*_\[\]`>]/g, '').substring(0, 200) %>">

    <title><%= til.title %> &mdash; <%= appName %></title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="/static/css/bootstrap.min.css">
    <link rel="stylesheet" href="/static/css/hljs/github-dark-dimmed.min.css">
    <link rel="stylesheet" href="/static/css/app.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <meta name="theme-color" content="#a25776">
</head>

<body class="public-page">

    <div class="public-container">
        <!-- Header -->
        <header class="public-header">
            <a href="/" class="public-brand">
                <img src="/static/images/icons/app-icon-96.png" width="28" alt="TIL"/>
                <span><%= appName %></span>
            </a>
        </header>

        <!-- Article -->
        <article class="public-article">
            <div class="public-article-meta">
                <time datetime="<%= til.date.toISOString() %>"><%= til.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
                <span class="public-meta-sep">&middot;</span>
                <span>by <strong><%= author %></strong></span>
            </div>

            <h1 class="public-article-title"><%= til.title %></h1>

            <div class="public-tags">
                <% for (let tag in til.tags) { %>
                    <span class="public-tag"><%= til.tags[tag] %></span>
                <% } %>
            </div>

            <div class="public-article-body">
                <div id="tildescription" class="md description"><%= til.description %></div>
            </div>
        </article>

        <% if (til_images && til_images.length > 0) { %>
        <section class="public-section">
            <h2 class="public-section-title">Images</h2>
            <div class="public-images-grid">
                <% for (let img of til_images) { %>
                    <a href="/image/<%= img.id %>" target="_blank" class="public-image-link">
                        <img src="/image/<%= img.id %>" alt="<%= img.filename %>" loading="lazy">
                    </a>
                <% } %>
            </div>
        </section>
        <% } %>

        <% if (til_urls && til_urls.length > 0) { %>
        <section class="public-section">
            <h2 class="public-section-title">References</h2>
            <ul class="public-urls">
                <% for (let i in til_urls) { %>
                    <li><a href="<%= til_urls[i] %>" target="_blank" rel="noopener noreferrer"><%= til_urls[i].replace(/^https?:\/\//, '') %></a></li>
                <% } %>
            </ul>
        </section>
        <% } %>

        <!-- Footer -->
        <footer class="public-footer">
            <div class="public-footer-inner">
                <p class="public-footer-cta">
                    <% if (authorPublicCount > 1) { %>
                        <a href="/public/user/<%= userId %>">See all <%= authorPublicCount %> public learnings by <%= author %></a>
                    <% } %>
                </p>
                <p class="public-footer-brand">
                    Shared via <a href="/"><%= appName %></a>
                </p>
            </div>
        </footer>
    </div>

<script src="/static/js/showdown.min.js"></script>
<script src="/static/js/hljs/highlight.min.js"></script>
<script>
// Render markdown
const converter = new showdown.Converter();
const mdElements = document.getElementsByClassName('md');
for (let mde of mdElements) {
    mde.innerHTML = converter.makeHtml(mde.textContent);
}
// Syntax highlighting
if (typeof hljs !== 'undefined') {
    document.querySelectorAll('pre code').forEach((block) => {
        hljs.highlightElement(block);
    });
}
</script>
</body>

</html>
