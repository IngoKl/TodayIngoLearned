<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>


<main class="flex-shrink-0">
    <div class="container">

        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><%= til.title %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= til.date.toLocaleDateString('de-DE') %></h6>
                <% for (let tag in til.tags) { %>
                    <a href="/tag/<%=til.tags[tag].substring(1) %>"><span class="badge bg-secondary"><%=til.tags[tag] %></span></a>
                <% } %>

                <hr>
                <p id="tildescription" class="card-text md description" data-til-id="<%= til.til_id %>"><%=til.description %></p>
                <hr>

                <a href="/comment/add/<%= til.til_id %>" class="btn btn-secondary">Add Comment</a>
                <a href="/til/edit/<%= til.til_id %>" class="btn btn-primary">Edit</a>
                <%if (bookmarked) { %>
                    <a href="/til/edit/<%= til.til_id %>/bookmark" class="btn bg-warning">⚑</a>
                <% } else {  %>
                    <a href="/til/edit/<%= til.til_id %>/bookmark" class="btn bg-warning">⚐</a>
                <% } %>
                <a href="/til/view/<%= til.til_id %>/markdown" class="btn btn-secondary">🗎</a>
                <% if (til.public) { %>
                    <span class="ms-2 badge bg-success">Public</span>
                    <small class="ms-1 text-muted"><a href="/public/<%= til.til_id %>">/public/<%= til.til_id %></a></small>
                <% } %>
            </div>
        </div>

        <br>

        <% if (til_images && til_images.length > 0) { %>
        <br>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Images</h5>
                <div class="d-flex flex-wrap gap-2 til-images-gallery">
                    <% for (let img of til_images) { %>
                        <a href="/image/<%= img.id %>" target="_blank">
                            <img src="/image/<%= img.id %>" alt="<%= img.filename %>"
                                 style="max-width: 200px; max-height: 150px; object-fit: cover;"
                                 class="rounded border">
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>

        <%if (til_urls) { %>
            <%if (til_urls.length > 0) { %>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">URLs</h5>
                    <% for (let i in til_urls) { %>
                        <a href="<%= til_urls[i] %>" target="_blank" rel="noopener noreferrer"><%= til_urls[i] %></a><br>
                    <% } %>
                </div>
            </div>
            <% } %>
        <% } %>
        
        <% if (related_tils && related_tils.length > 0) { %>
        <br>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Related TILs</h5>
                <% for (let i = 0; i < related_tils.length; i++) { %>
                    <div class="d-flex justify-content-between align-items-center<%= i < related_tils.length - 1 ? ' mb-2' : '' %>">
                        <a href="/til/view/<%= related_tils[i].id %>"><%= related_tils[i].title %></a>
                        <small class="text-muted ms-2 text-nowrap">
                            <%= related_tils[i].shared_count %> shared tag<%= related_tils[i].shared_count > 1 ? 's' : '' %>
                        </small>
                    </div>
                <% } %>
            </div>
        </div>
        <% } %>

        <%if (comments.length > 0) { %>
        <hr>
        <h3>Comments</h3>

        <% for (var i = 0; i < comments.length; i++) { %>
            <div class="card">
                <div class="card-body">
                    <p class="md description"><%=comments[i].comment %></p>
                    <hr>
                    <a href="/comment/edit/<%= comments[i].id %>"><button class="btn btn-secondary">Edit</button></a>
                    <a href="/comment/delete/<%= comments[i].id %>"><button class="btn btn-danger">Delete</button></a>
                </div>
            </div>
            <br>
        <% } %>

        <a href="/comment/add/<%= til.til_id %>" class="btn btn-primary">Add Comment</a>
        <% } %>

    </div>
</main>

<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>