<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">✌️ Hi, <strong><%= user.username %></strong></h5>
                <p>
                    <ul>
                        <li><strong>Number of TILs</strong>: <%= user_stats.tils %></li>
                        <li><strong>Number of Unique Tags</strong>: <%= user_stats.unique_tags %></li>
                        <li><strong>Number of Bookmarks</strong>: <%= user_stats.bookmarks %></li>
                    </ul>
                </p>

                <hr>
                <h6>API Key</h6>
                <% if (api_key) { %>
                    <p><code><%= api_key %></code></p>
                    <p class="text-muted">Use this key in the <code>X-API-Key</code> header to authenticate API requests.</p>
                <% } else { %>
                    <p class="text-muted">No API key generated yet.</p>
                <% } %>
                <form method="post" action="/user/api-key" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-outline-primary"><%= api_key ? 'Regenerate' : 'Generate' %> API Key</button>
                </form>

                <% if (api_key) { %>
                <details class="mt-3">
                    <summary class="text-muted" style="cursor:pointer">Usage examples</summary>
                    <div class="mt-2">
                        <p class="mb-1"><strong>Get a TIL:</strong></p>
                        <pre class="bg-body-secondary p-2 rounded"><code>curl -H "X-API-Key: <%= api_key %>" http://localhost:3000/api/v1/til/1</code></pre>

                        <p class="mb-1"><strong>Create a TIL:</strong></p>
                        <pre class="bg-body-secondary p-2 rounded"><code>curl -X POST http://localhost:3000/api/v1/til ^
  -H "X-API-Key: <%= api_key %>" ^
  -H "Content-Type: application/json" ^
  -d "{\"title\": \"My TIL\", \"description\": \"Learned something #misc\", \"date\": \"2026-03-21\"}"</code></pre>

                        <p class="mb-1"><strong>Search TILs by title:</strong></p>
                        <pre class="bg-body-secondary p-2 rounded"><code>curl -H "X-API-Key: <%= api_key %>" "http://localhost:3000/api/v1/til/search?type=title&q=javascript"</code></pre>

                        <p class="mb-1"><strong>Search TILs by tag:</strong></p>
                        <pre class="bg-body-secondary p-2 rounded"><code>curl -H "X-API-Key: <%= api_key %>" "http://localhost:3000/api/v1/til/search?type=tag&q=%23misc"</code></pre>
                    </div>
                </details>
                <% } %>
                <hr>

                <p>
                    <button id="themeToggle" class="btn btn-primary">Toggle Dark Mode</button>
                </p>

                <a href="/logout" class="btn btn-secondary">Logout</a>
            </div>
        </div>
    </div>
</main>


<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>