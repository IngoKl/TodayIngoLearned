<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %> - Admin</title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>

<main class="flex-shrink-0">
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Admin</h5>
                <p class="text-muted"><%= users.length %> registered user<%= users.length !== 1 ? 's' : '' %></p>

                <h6 class="mt-4">Create New User</h6>
                <% if (typeof query !== 'undefined' && query.error) { %>
                    <div class="alert alert-danger"><%= query.error %></div>
                <% } %>
                <% if (typeof query !== 'undefined' && query.success) { %>
                    <div class="alert alert-success"><%= query.success %></div>
                <% } %>
                <form action="/admin/createuser" method="POST" class="row g-2 mb-4">
                    <div class="col-auto">
                        <input type="text" class="form-control" name="username" placeholder="Username" required>
                    </div>
                    <div class="col-auto">
                        <input type="password" class="form-control" name="password" placeholder="Password" required>
                    </div>
                    <div class="col-auto">
                        <input type="text" class="form-control" name="displayname" placeholder="Display Name (optional)">
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Username</th>
                                <th>Display Name</th>
                                <th>TILs</th>
                                <th>Tags</th>
                                <th>Bookmarks</th>
                                <th>Comments</th>
                                <th>Admin</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const u of users) { %>
                            <tr>
                                <td><%= u.id %></td>
                                <td><%= u.username %></td>
                                <td><%= u.displayname %></td>
                                <td><%= u.tils_count %></td>
                                <td><%= u.tags_count %></td>
                                <td><%= u.bookmarks_count %></td>
                                <td><%= u.comments_count %></td>
                                <td><%= u.is_admin ? 'Yes' : '' %></td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include ('partials/footer_text.ejs') %>
<%- include ('partials/footer.ejs') %>
</body>

</html>
