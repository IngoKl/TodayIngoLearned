<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
	<%- include ('partials/head.ejs') %>
	<title><%= appName %></title>
	<link href="/static/css/login.css" rel="stylesheet">
</head>

<body class="text-center">

	<main class="form-signin">
		<form method="post" action="/login">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<img class="mb-4" src="/static/images/icons/app-icon.png" alt="<%= appName %>" width="144" height="144">
			<h1 class="h3 mb-3 font-weight-normal">Welcome to TIL!</h1>
			<br>
			<% if (typeof error !== 'undefined' && error) { %>
				<div class="alert alert-danger text-start" role="alert"><%= error %></div>
			<% } %>

			<div class="form-floating mb-3">
				<input autocomplete="username" type="text" name="username" id="username" class="form-control" placeholder="Ingo">
				<label for="username">Username</label>
			</div>
			<div class="form-floating mb-3">
				<input autocomplete="current-password" type="password" name="password" id="password" class="form-control" placeholder="Password">
				<label for="password">Password</label>
			</div>

			<button class="w-100 btn btn-lg btn-primary" type="submit">Login</button>
			<p class="mt-5 mb-3 text-muted"><%- include ('partials/til_years.ejs') %></p>
		</form>
	</main>

	<%- include ('partials/footer.ejs') %>
</body>

</html>
