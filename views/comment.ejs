<!doctype html>
<%- include ('partials/html.ejs') %>

<head>
    <%- include ('partials/head.ejs') %>
    <title><%= appName %></title>
</head>

<body>
<%- include ('partials/navigation.ejs') %>


<main class="flex-shrink-0">
    <div class="container">
        <div class="card">
            <div class="card-body">
                <p class="md description"><%=comment.comment %></p>
                <hr>
                <a href="/comment/edit/<%= comment.id %>"><button class="btn btn-secondary">Edit</button></a>
                <form method="POST" action="/comment/delete/<%= comment.id %>" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this comment?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include ('partials/footer_text.ejs') %>

<%- include ('partials/footer.ejs') %>
</body>

</html>